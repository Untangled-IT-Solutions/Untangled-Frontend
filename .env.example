# Leave blank when the frontend and API are deployed on the same domain.
# Local development proxies /api to the backend automatically.
VITE_API_URL=

# Server settings
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Configure one database option. Never prefix server secrets with VITE_.
DATABASE_URL=
# Alternatively, use Supabase's quotes table through its REST API:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notifications; quote storage works without this key.
RESEND_API_KEY=
